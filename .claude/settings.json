{
  "env": {
    "IMPECCABLE_LIVE_COPY_AGENT": "chat",
    "WATCH_ENGINE": "local",
    "WATCH_DETAIL": "efficient"
  },
  "enabledPlugins": {
    "lemo-opuscar@lemolab": true,
    "andrej-karpathy-skills@karpathy-skills": true,
    "impeccable@impeccable": true,
    "watch@claude-video": true
  },
  "extraKnownMarketplaces": {
    "lemolab": {
      "source": {
        "source": "github",
        "repo": "lemomo-ai/lemo-opuscar",
        "sparsePaths": [
          ".claude-plugin",
          "plugin"
        ]
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable",
        "sparsePaths": [
          ".claude-plugin",
          "plugin"
        ]
      }
    },
    "claude-video": {
      "source": {
        "source": "github",
        "repo": "bradautomates/claude-video"
      }
    }
  }
}
